{
  "name": "setup-bruin",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild --minify --bundle --sourcemap '--define:process.env.NODE_ENV=\"production\"' --outdir=dist --platform=node --target=node20 ./src/main.ts",
    "eslint": "eslint --max-warnings 0 .",
    "format": "prettier --write '**/*.{json,js,jsx,ts,tsx,css}' --loglevel error",
    "lint": "npm run eslint && npm run types-check",
    "types-check": "tsc --noemit"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2",
    "@octokit/core": "^5.2.2",
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "^6.28.0"
    },
    "browserslist": "^4.28.9",
    "js-yaml": "^4.3.1",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    }
  }
}
